{Spin2_v45}


con

    WIDGET_TYPE         = wgui.TYPE_WINDOW

    ' limits
    MAX_WINDOWS         = 4
    MAX_OBJECTS         = 16

    ' option flags
    FLAG_DRAW_OUTLINE   = 1 << 0
    FLAG_DRAW_FILL      = 1 << 1

    ' default settings
    DEF_WIDTH           = 128
    DEF_HEIGHT          = 64
    DEF_BORDER_COLOR    = 1
    DEF_FILL_COLOR      = 0
    DEF_GRID_X          = 1
    DEF_GRID_Y          = 1
    DEF_FLAGS           = FLAG_DRAW_OUTLINE | FLAG_DRAW_FILL


#include "gui-common.spin2"
#include "container-common.spin2"

obj

    wgui:   "gui.widget"
    scr:    "gui.screen"


con

    struct widget_s = wgui.widget_s
    struct screen_s = scr.screen_s

    struct window_s(...
        widget_s widget, ...
        container_s container, ...
        long border_color, ...
        long fill_color, ...
        word grid_x, ...
        word grid_y)


var

    window_s    window[MAX_WINDOWS]
    byte        _nr_win


pub create(^screen_s scr, w=0, h=0, gx=0, gy=0): ^window_s win
' Create a window
'   dobj:       display driver object instance (pointer to object)
'   w, h:       dimensions (optional; sets DEF_WIDTH and DEF_HEIGHT if not specified)
'   gx, gy:     grid spacing of contained GUI objects (pixels)
'   Returns:    pointer to window struct on success
'               0 on failure (window array full)

'   NOTE:       The window will initially be placed at the parent screen's cursor coordinates.

    if ( _nr_win < MAX_WINDOWS )
        if ( w < 1 )
            w := DEF_WIDTH
        if ( h < 1 )
            h := DEF_HEIGHT

        [win] := @window[_nr_win]               ' point to next available window memory

        win.widget.type := wgui.TYPE_WINDOW     ' set up widget header
        win.widget.x := scr.container.cursor.x
        win.widget.y := scr.container.cursor.y
        win.widget.w := w
        win.widget.h := h
        win.widget.abs_x := win.widget.x
        win.widget.abs_y := win.widget.y
        win.widget.parent := [scr]
        win.widget.draw := @draw
        win.widget.p_disp := scr.p_disp         ' point to display driver object

        win.grid_x := gx                        ' set the new window's grid spacing
        win.grid_y := gy
        ifnot ( win.grid_x )                    ' (default to 1 if not specified)
            win.grid_x := DEF_GRID_X
        ifnot ( win.grid_y )
            win.grid_y := DEF_GRID_Y

        win.container.cursor.x := win.grid_x    ' init window cursor to upper left corner+grid size
        win.container.cursor.y := win.grid_y

        ' initialize/clear object buffer
        longfill(@win.container.buffer, 0, MAX_OBJECTS)
        win.container.count := 0

        win.widget.flags := DEF_FLAGS

        _nr_win++
        DEBUG("[win] create: sx=", udec_(win.widget.x), " sy=", udec_(win.widget.y), " ex=", udec_(win.widget.x+win.widget.w-1), " ey=", udec_(win.widget.y+win.widget.h-1) )

        return

    DEBUG("[win] create: error; out of memory")
    return 0


pub count(): t
' Get the number of defined windows
    DEBUG("[win] ", udec_(_nr_win), " windows")
    return _nr_win


pub display_ptr(^window_s win): p
' Get a window's attached display driver object
'   win:        pointer to window struct
'   Returns:    pointer to display driver object
    return win.widget.p_disp


pub draw(p_win=0) | ^window_s win, ^dispdrv_i disp, x, y
' Draw a window
'   p_win:  window handle (optional if called indirectly via the struct itself)
    ifnot ( p_win )                             ' get the window's pointer from the parent struct,
        [win] := %self                          '   if none was specified
    else
        [win] := p_win

    [disp] := win.widget.p_disp

    x := win.widget.abs_x
    y := win.widget.abs_y

    if ( win.widget.flags & FLAG_DRAW_OUTLINE ) ' show the window outline
        disp.box(   x, y, ...
                    x+win.widget.w-1, y+win.widget.h-1, ...
                    win.border_color, ...
                    false)

    if ( win.widget.flags & FLAG_DRAW_FILL )    ' show fill area inside the outline
        disp.box(   x+1, y+1, ...
                    x+win.widget.w-2, y+win.widget.h-2, ...
                    win.fill_color, ...
                    true)
    DEBUG("[gui.window] draw(", uhex_(p_win), ") ", udec_(x), udec_(y), udec_(x+win.widget.w-1), udec_(y+win.widget.h-1) )


pub obj_attach(^window_s win, p_obj): n | ^widget_s wp, ex, ey
' Attach a GUI object to a window's tree
'   win:    pointer to window struct to attach object to
'   p_obj:  pointer to object struct
'   Returns:    index in object tree array on success
'               -1 on failure (object array is full)
    n := win.container.count
    if ( n < MAX_OBJECTS )
        [wp] := p_obj
        DEBUG("[win] obj_attach: obj type ", zstr_(lookup(wp.type: @"TYPE_WINDOW", @"TYPE_BUTTON", @"TYPE_TEXTLABEL", @"TYPE_PROGRESSBAR") ), " w=", udec_(wp.w) )
        DEBUG("[win] obj_attach: cursor before ", udec_(win.container.cursor.x), udec_(win.container.cursor.y) )
        win.container.buffer[n] := p_obj        ' add the object's pointer
        win.container.count++

        ' move the window cursor by the size of the obj, wrapping around to the left (or top)
        win.container.cursor.x += (wp.w+win.grid_x)

        if ( win.container.cursor.x > (win.widget.x+win.widget.w-1) )
            DEBUG("[win] obj_attach: cursor.x=", udec_(win.container.cursor.x), "; wrapping")
            win.container.cursor.x := win.grid_x
            win.container.cursor.y += wp.h+win.grid_y
        if ( win.container.cursor.y > (win.widget.y+win.widget.h-1) )
            DEBUG("[win] obj_attach: cursor.y=", udec_(win.container.cursor.y), "; wrapping")
            win.container.cursor.x := win.grid_x
            win.container.cursor.y := win.grid_y

        DEBUG("[win] obj_attach: cursor after ", udec_(win.container.cursor.x), udec_(win.container.cursor.y) )
        return

    DEBUG("[win] obj_attach: window ", uhex_(@win), " error: out of memory (object buffer full)")
    return -1


pub fit_cursor(^window_s win, w, h)
' Attempt to reposition the cursor based on the given dimensions
'   win:    pointer to window struct
'   w, h:   dimensions of object
    if ( (win.container.cursor.x+w) > (win.widget.x+win.widget.w-1) )
        DEBUG("[win] fit_cursor: cursor.x=", udec_(win.container.cursor.x), "; wrapping")
        win.container.cursor.x := win.grid_x
        win.container.cursor.y += h+win.grid_y
    if ( win.container.cursor.y > (win.widget.y+win.widget.h-1) )
        DEBUG("[win] fit_cursor: cursor.y=", udec_(win.container.cursor.y), "; wrapping")
        win.container.cursor.x := win.grid_x
        win.container.cursor.y := win.grid_y


pub obj_detach(^window_s win, p_obj): o
' Detach an object from a window (by pointer to object)
'   win:        pointer to window struct
'   p_obj:      pointer to object struct to detach
'   Returns:    array index of object within window on success
'               -1 on failure (object with that pointer not found)
    repeat o from 0 to win.container.count-1    ' find the object's pointer in the tree
        if ( win.container.buffer[o] == p_obj ) ' matching pointer?
            if ( o < (MAX_OBJECTS-1) )          ' pack pointers downwards if we're not at the end
                longmove(   @win.container.buffer[o], ...
                            @win.container.buffer[o+1], ...
                            MAX_OBJECTS-1-o)
            win.container.buffer[MAX_OBJECTS-1] := 0
            win.container.count--
            return o

    return -1                                   ' pointer not found in the tree


pub obj_detach_nr(^window_s win, obj_nr): n
' Detach an object from a window (by array index #)
'   win:        pointer to window struct
'   obj_nr:     object array index number
'   Returns:    array index of object within window on success
'               -1 on failure (object with that pointer not found)
    if ( win.container.buffer[obj_nr] )
        n := obj_nr
        if ( n < (MAX_OBJECTS-1) )
            longmove(   @win.container.buffer[n], ...   ' pack pointers downwards
                        @win.container.buffer[n+1], ...
                        MAX_OBJECTS-1-n)
        win.container.buffer[MAX_OBJECTS-1] := 0
        win.container.count--
        return n

    return -1


pub posx_center(^window_s win): y
' Get the horizontal center position within a window
'   win:        pointer to window struct
'   Returns:    x-coordinate (pixels)
    return win.widget.w / 2


pub posy_center(^window_s win): y
' Get the vertical center position within a window
'   win:        pointer to window struct
'   Returns:    y-coordinate (pixels)
    return win.widget.h / 2


pub set_border_color(^window_s win, c)
' Set a window's border color
'   win:    pointer to window struct
'   c:      border color
    win.border_color := c


pub set_fill_color(^window_s win, c)
' Set a window's interior fill color
'   win:    pointer to window struct
'   c:      fill color
    win.fill_color := c


pub set_grid(^window_s win, gx, gy)
' Set a window's interior cursor position grid spacing (used when automatically placing new objects)
'   win:    pointer to window struct
'   gx, gy: x-axis/horizontal, y-axis/vertical spacing (pixels)
    if ( win.widget.type == WIDGET_TYPE )
        win.grid_x := gx
        win.grid_y := gy


pub set_posxy(^window_s win, x, y)
' Set a window's interior cursor position
'   win:    pointer to window struct
'   x, y:   x-axis/horizontal, y-axis/vertical position (pixels)
    win.container.cursor.x := x
    win.container.cursor.y := y


dat
