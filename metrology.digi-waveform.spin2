{Spin2_v45}

#include "gui.common.spin2"                     ' define display driver API req's, etc

con

    ' limits
    MAX_DIGI_PLOTS  = 4

    ' sample record
    struct sample_s(...
        long state, ...
        long duration)


obj

    slicer: "dsp.byte-slicer"


var

    digi_plot_s digi_plot[MAX_DIGI_PLOTS]
    digi_plot_s defaults
    byte        _nr_digi_plots


pub create(^window_s pwin): ^digi_plot_s i | ^widget_s wp
' Create a digital waveform plot object (use currently set defaults)
'   pwin:   parent window (pointer to window_s struct)
'   x, y:   plot upper-left position (pixels)
'   w, h:   plot dimensions (pixels)
'   Returns:
'           plot handle on success (pointer)
'           0 on failure (exceeded parent window's maximum number of obects,
'                           or this object's maximum number of plots)
    if ( (pwin.nr_obj < MAX_WIN_OBJS ) and (_nr_digi_plots < MAX_DIGI_PLOTS) )
        [i] := @digi_plot[_nr_digi_plots]
        [wp] := @digi_plot[_nr_digi_plots].widget

        ' use the currently set defaults as a template for the new button
        bytemove(@i, @defaults, sizeof(digi_plot_s) )
        set_type(@wp,       OBJ_DIGI_PLOT)
        set_parent_obj(@wp, @pwin)
        set_x_zoom(@i,      0_001000)           ' default to 0.001x zoom
        set_plot_color(@i,  pwin.widget.fgcolor)' inherit plot color from parent's foreground color

        ' check if the plot will fit at the current window cursor
        if ( ((pwin.cursor.x + wp.w) < (pwin.widget.x+pwin.widget.w-1)) and ...
             ((pwin.cursor.y + wp.h) < (pwin.widget.y+pwin.widget.h-1)) )
            set_posxy(@wp,       pwin.cursor.x, pwin.cursor.y)

            ' move the window's cursor for the next object
            pwin.cursor.x += wp.w+pwin.grid_spacing_x
            if ( pwin.cursor.x > (pwin.widget.x+pwin.widget.w-1) )
                pwin.cursor.x := (pwin.widget.x+pwin.grid_spacing_x)
                pwin.cursor.y += wp.h+pwin.grid_spacing_y
            if ( pwin.cursor.y > (pwin.widget.y+pwin.widget.h-1) )
                pwin.cursor.y := pwin.widget.y

        pwin.object[pwin.nr_obj] := @i
        pwin.nr_obj++
        _nr_digi_plots++
        return

    return 0


pub create_explicit(^window_s pwin, x, y, w, h): ^digi_plot_s i | ^widget_s wp
' Create a digital waveform plot object (set parameters explicitly)
'   pwin:   parent window (pointer to window_s struct)
'   x, y:   plot upper-left position (pixels)
'   w, h:   plot dimensions (pixels)
'   Returns:
'           plot handle on success (pointer)
'           0 on failure (exceeded parent window's maximum number of obects,
'                           or this object's maximum number of plots)
    if ( (pwin.nr_obj < MAX_WIN_OBJS ) and (_nr_digi_plots < MAX_DIGI_PLOTS) )
        [i] := @digi_plot[_nr_digi_plots]
        [wp] := @digi_plot[_nr_digi_plots].widget

        set_type(@wp,       OBJ_DIGI_PLOT)
        set_parent_obj(@wp, @pwin)
        set_posxy(@wp,      x, y)
        set_dims(@wp,       w, h)
        set_bgcolor(@wp,    pwin.widget.bgcolor)' inherit widget colors from parent
        set_fgcolor(@wp,    pwin.widget.fgcolor)
        set_x_zoom(@i,      0_001000)           ' default to 0.001x zoom
        set_plot_color(@i,  pwin.widget.fgcolor)' inherit plot color from parent's foreground color

        pwin.object[pwin.nr_obj] := @i
        pwin.nr_obj++
        _nr_digi_plots++
        return

    return 0


pub destroy(^digi_plot_s plot): s
' Destroy a digi-plot object
'   plot:       digi-plot (pointer to digi_plot_s struct)
'   Returns:    number of plots before destruction
    if ( (_nr_digi_plots > 0) and (plot.widget.type == OBJ_DIGI_PLOT) )
    ' do some basic safeguards before just clearing memory
        plot~
        s := _nr_digi_plots
        _nr_digi_plots--
        return

    return false


pub draw(^digi_plot_s plot) | ^window_s win, le, te, re, be, cx, y, py, s, dur_s, ls, ^dispdrv_i disp, ^slicer.capture_s cap
' Draw a digital waveform plot to a window
'   win:    pointer to window to draw to
'   cfg:    pointer to threshold plot config
'   sample: pointer to sample array
'   slen:   sample array length
'   NOTE: The window being drawn to MUST have a display driver defined first
'   NOTE: The position drawn will be relative to the window the plot is drawn to.
    [win] := plot.widget.parent                 ' get handle on parent window
    [disp] := win.p_disp                        ' inherit display driver from window
    [cap] := plot.p_plot

    ' get base coordinates from the window we're drawing to
    te := win.widget.y + plot.widget.y+1        ' pre-calc top edge
    le := win.widget.x + plot.widget.x+1        ' pre-calc left edge
    re := le + plot.widget.w-1                  ' pre-calc right edge
    be := te + plot.widget.h-1                  ' pre-calc bottom edge

    cx := le

    s := 0
    ls := cap.record[s].state

    disp.box(le, te, re, be, plot.widget.bgcolor, true)     ' clear plot area

    repeat while (cx < re)                      ' plot until the right edge is reached
        py := te + ( (cap.record[s].state ^ plot.invert_y) * (plot.widget.h-1))
        dur_s := muldiv64(cap.record[s].time, plot.x_zoom, 1_000000) ' scale by zoom factor
        if ( cap.record[s].state <> ls )        ' draw transition
            disp.vline(cx, te, plot.widget.h, plot.plot_color)

        ' draw high or low level
        disp.hline(py, cx, dur_s <# (re-cx), plot.plot_color)
        cx := cx + dur_s <# re
        ls := cap.record[s].state               ' remember state for next transition
        s++                                     ' next sample
        if ( s >= cap.len )
            return


pub draw_to_disp(^dispdrv_i disp, ^digi_plot_s plot, ^sample_s sample, slen) | re, be, x, y, py, s, dur_s, ls
' Draw a digital waveform plot (windowless)
'   disp:   pointer to display driver object
'   plot:   pointer to threshold plot config
'   sample: pointer to sample array
'   slen:   length of sample array
    x := plot.widget.x
    ls := sample[s].state
    re := (plot.widget.x + plot.widget.w)-1                 ' pre-calc right edge
    be := (plot.widget.y + plot.widget.h)-1                 ' pre-calc bottom edge

    s := 0

    ' clear plot area
    disp.box(plot.widget.x, plot.widget.y, re, be, plot.widget.bgcolor, true)

    repeat while (x < re)                                   ' plot until the right edge is reached
        py := plot.widget.y + ( (sample[s].state ^ plot.invert_y) * (plot.widget.h-1))
        dur_s := muldiv64(sample[s].duration, plot.x_zoom, 1_000000)    ' scale by zoom factor
        if ( sample[s].state <> ls )                        ' draw transition
            disp.vline(x, plot.widget.y, plot.widget.h, plot.plot_color)

        ' draw high or low level
        disp.hline(py, x, dur_s <# (re-x), plot.plot_color)
        x := x + dur_s <# re
        ls := sample[s].state                               ' remember state for next comparison
        s++                                                 ' next sample
        if ( s >= slen )
            return


pub dec_x_zoom(^digi_plot_s plot, v=1)
' Decrease X zoom factor
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   v:      value to decrease zoom factor by (optional; default is 1, or 0.000_001x)
    plot.x_zoom -= v
    plot.x_zoom #>= 0_000001


pub get_x_zoom(^digi_plot_s plot): z
' Increase X zoom factor
'   plot:       digi-plot (pointer to digi_plot_s struct)
'   Returns:    current zoom factor
    return plot.x_zoom


pub inc_x_zoom(^digi_plot_s plot, v=1)
' Increase X zoom factor
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   v:      value to increase zoom factor by (optional; default is 1, or 0.000_001x)
    plot.x_zoom += v


pub invert_y(^digi_plot_s plot, i=-1)
' Invert drawing of the plot (y-axis)
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   i:      invert flag (optional)
'               if unspecified (or -1), flip current state
'               if 0, don't invert y-axis plotting
'               if non-zero, invert y-axis plotting
    if ( i == -1 )                              ' flip current state
        plot.invert_y := plot.invert_y ^ 1
    else                                        ' set state explicitly
        plot.invert_y := (i <> 0) & 1           ' non-zero = invert, 0 = no inversion


pub ptr_widget(^digi_plot_s plot): ^widget_s ow
' Get pointer to a digi-plot's widget configuration
'   plot:       digi-plot (pointer to digi_plot_s struct)
'   Returns:    pointer to widget_s struct
    return @plot.widget


pub set_default_bgcolor(c)
' Set default background color for new digital waveform plots
'   c:  color
    defaults.widget.bgcolor := c


pub set_default_fgcolor(c)
' Set default foreground color for new digital waveform plots
'   c:  color
    defaults.widget.fgcolor := c


pub set_default_dims(w, h)
' Set default dimensions for new digital waveform plots
    defaults.widget.w := w
    defaults.widget.h := h


pub set_plot_color(^digi_plot_s plot, c)
' Set waveform plot color
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   c:      color
    plot.plot_color := c


pub set_plot_data(^digi_plot_s plot, p_data)
' Set plot data used by a waveform plotter
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   p_data: plot/capture data (pointer; typically a capture_s struct)
    plot.p_plot := p_data


pub set_x_zoom(^digi_plot_s plot, z)
' Set waveform X-axis/timescale zoom
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   z:      scale factor (in millionths, i.e., 0_000001 = 0.000001, 1_000000 = 1.000000)
    plot.x_zoom := 0_000001 #> z


dat
