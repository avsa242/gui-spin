{Spin2_v45}

#include "widget-common.spin2"
#include "gui-common.spin2"


con

    WIDGET_TYPE         = TYPE_DIGI_PLOT

    ' limits
    MAX_DIGI_PLOTS      = 1


    ' option flags
    FLAG_DRAW_OUTLINE   = 1 << 0
    FLAG_DRAW_FILL      = 1 << 1


    ' default settings
    DEF_WIDTH           = 2
    DEF_HEIGHT          = 2
    DEF_BORDER_COLOR    = 1
    DEF_FILL_COLOR      = 0
    DEF_PLOT_COLOR      = 1
    DEF_X_ZOOM          = 0_000050
    DEF_INVERT_Y        = false
    DEF_FLAGS           = FLAG_DRAW_OUTLINE | FLAG_DRAW_FILL


obj

    slicer: "dsp.byte-slicer"
    window: "gui.window"


con

    struct window_s = window.window_s

    ' sample record
    struct sample_s(...
        long state, ...
        long duration)

    struct digi_plot_s(...
        widget_s widget, ...
        long plot_color, ...
        long fill_color, ...
        long border_color, ...
        long x_zoom, ...
        long p_plot, ...
        byte invert_y)


var

    digi_plot_s digi_plot[MAX_DIGI_PLOTS]
    byte        _nr_digi_plots


pub create(p_plot, w=0, h=0): ^digi_plot_s plot
' Create a digital waveform plot object (use currently set defaults)
'   pwin:   parent window (pointer to window_s struct)
'   Returns:
'           plot handle on success (pointer)
'           0 on failure (exceeded parent window's maximum number of objects,
'                           or this object's maximum number of plots)

    if ( _nr_digi_plots < MAX_DIGI_PLOTS )
        if ( w < 1 )
            w := DEF_WIDTH
        if ( h < 1 )
            h := DEF_HEIGHT

        [plot] := @digi_plot[_nr_digi_plots]
        plot.widget.w := w
        plot.widget.h := h
        plot.widget.type := TYPE_DIGI_PLOT
        plot.widget.draw := @draw
        plot.widget.flags := DEF_FLAGS

        plot.plot_color := DEF_PLOT_COLOR
        plot.fill_color := DEF_FILL_COLOR
        plot.border_color := DEF_BORDER_COLOR
        plot.x_zoom := DEF_X_ZOOM
        plot.invert_y := DEF_INVERT_Y

        plot.p_plot := p_plot

        _nr_digi_plots++
        return

    return 0


pub destroy(^digi_plot_s plot): s   'xxx this doesn't handle gaps in the array
' Destroy a digi-plot object
'   plot:       digi-plot (pointer to digi_plot_s struct)
'   Returns:    number of plots before destruction
    if ( (_nr_digi_plots > 0) and (plot.widget.type == OBJ_DIGI_PLOT) )
    ' do some basic safeguards before just clearing memory
        plot~
        s := _nr_digi_plots
        _nr_digi_plots--
        return

    return false


pub draw(p_plot=0) | ^digi_plot_s plot, ^window_s win, le, te, re, be, cx, y, py, s, dur_s, ls, ^dispdrv_i disp, ^slicer.capture_s cap
' Draw a digital waveform plot to a window
'   plot:   pointer to threshold plot config
'   NOTE: The window being drawn to MUST have a display driver defined first
'   NOTE: The position drawn will be relative to the window the plot is drawn to.
    ifnot ( p_plot )
        [plot] := %self
    else
        [plot] := p_plot

    [disp] := plot.widget.p_disp
    [win] := plot.widget.parent
    [cap] := plot.p_plot

    ' get base coordinates from the window we're drawing to
    te := plot.widget.y                         ' pre-calc top edge
    le := plot.widget.x                         ' pre-calc left edge
    re := le + plot.widget.w-1                  ' pre-calc right edge
    be := te + plot.widget.h-1                  ' pre-calc bottom edge

    cx := le

    s := 0
    ls := cap.record[s].state

    if ( plot.widget.flags & FLAG_DRAW_FILL )
        disp.box(le, te, re, be, plot.fill_color, true)     ' clear plot area

    repeat while (cx < re)                      ' plot until the right edge is reached
        py := te + ( (cap.record[s].state ^ plot.invert_y) * (plot.widget.h-1))
        dur_s := muldiv64(cap.record[s].time, plot.x_zoom, 1_000000) ' scale by zoom factor
        if ( cap.record[s].state <> ls )        ' draw transition
            disp.vline(cx, te, plot.widget.h, plot.plot_color)

        ' draw high or low level
        disp.hline(py, cx, dur_s <# (re-cx), plot.plot_color)
        cx := cx + dur_s <# re
        ls := cap.record[s].state               ' remember state for next transition
        s++                                     ' next sample
        if ( s >= cap.len )
            return


pub dec_x_zoom(^digi_plot_s plot, v=1)
' Decrease X zoom factor
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   v:      value to decrease zoom factor by (optional; default is 1, or 0.000_001x)
    plot.x_zoom -= v
    plot.x_zoom #>= 0_000001


pub get_x_zoom(^digi_plot_s plot): z
' Increase X zoom factor
'   plot:       digi-plot (pointer to digi_plot_s struct)
'   Returns:    current zoom factor
    return plot.x_zoom


pub inc_x_zoom(^digi_plot_s plot, v=1)
' Increase X zoom factor
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   v:      value to increase zoom factor by (optional; default is 1, or 0.000_001x)
    plot.x_zoom += v


pub invert_y(^digi_plot_s plot, i=-1)
' Invert drawing of the plot (y-axis)
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   i:      invert flag (optional)
'               if unspecified (or -1), flip current state
'               if 0, don't invert y-axis plotting
'               if non-zero, invert y-axis plotting
    if ( i == -1 )                              ' flip current state
        plot.invert_y := plot.invert_y ^ 1
    else                                        ' set state explicitly
        plot.invert_y := (i <> 0) & 1           ' non-zero = invert, 0 = no inversion


pub set_plot_color(^digi_plot_s plot, c)
' Set waveform plot color
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   c:      color
    plot.plot_color := c


pub set_plot_data(^digi_plot_s plot, p_data)
' Set plot data used by a waveform plotter
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   p_data: plot/capture data (pointer; typically a capture_s struct)
    plot.p_plot := p_data


pub set_x_zoom(^digi_plot_s plot, z)
' Set waveform X-axis/timescale zoom
'   plot:   digi-plot (pointer to digi_plot_s struct)
'   z:      scale factor (in millionths, i.e., 0_000001 = 0.000001, 1_000000 = 1.000000)
    plot.x_zoom := 0_000001 #> z


dat
