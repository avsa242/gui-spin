{Spin2_v46}

con

    ' common to multiple widgets
    struct widget_s( ...
        word    x, y, w, h, ...
        long    bgcolor, fgcolor )


    ' </// buttons
    struct button_s(...
        widget_s    params, ...
        long        p_text, ...
        byte        state)

    ' button states
    RELEASED        = 0
    PUSHED          = 1
    ' ///>


    ' </// sliders
    struct slider_s( ...
        widget_s    params, ...
        long        opts, ...
        word        val_initial, ...
        word        val, ...
        word        range )
    ' ///>


DAT
