{Spin2_v45}

con

    ' display driver API requirements
    %interface dispdrv_i(
        pub box(x1, y1, x2, y2, c, f)
        pub bgcolor(c)
        pub fgcolor(c)
        pub hline(y, xs, len, c)
        pub line(x1, y1, x2, y2, c)
        pub newline()
        pub plot(x, y, c)
        pub pos_xy(x, y)
        pub puts(p_str)
        pub vline(x, ys, len, c)
    )

    ' terminal driver API requirements
    %interface termdrv_i(
        pub clear_line()
        pub newline()
        pub pos_x(x)
        pub pos_xy(x, y)
        pub puts(p_str)
    )


    ' configuration structure used by all widgets
    struct widget_s( ...
        long type, ...
        long parent, ...
        long bgcolor, fgcolor, ...
        long event, ...
        long callback, ...
        word x, y, w, h, ...
        byte touch_id)



' Text windows
#ifndef TXT_LINE_MAX_LEN
# define TXT_LINE_MAX_LEN   80
#endif

#ifndef TEXTWIN_MAX_LINES
# define TEXTWIN_MAX_LINES  5
#endif

    ' line-buffer
    struct txt_line_s( byte text[TXT_LINE_MAX_LEN] )

    ' line-buffer window
    struct textwin_s(...
        widget_s widget, ...
        byte current_line, ...
        byte lines, ...
        txt_line_s line[TEXTWIN_MAX_LINES])
' --

' generic window
    MAX_WIN_OBJS    = 16

    struct window_s(...
        widget_s    widget, ...
        long        p_disp, ...
        long        object[MAX_WIN_OBJS], ...
        long        brd_color, ...
        byte        nr_obj)


    struct text_label_s(...
        widget_s    widget, ...
        long        p_fnt, ...
        long        p_str)


    struct progressbar_s(...
        widget_s    widget, ...
        long        outline_color, ...
        byte        state)


    struct button_s(...
        widget_s widget, ...
        long id, ...
        long text_sz, ...
        long options, ...
        long p_text, ...
        word font_w, ...
        word font_h, ...
        byte state)


    struct batt_gauge_s(...
        widget_s    widget, ...
        long        outline_color, ...
        byte        state)


    struct digi_plot_s(...
        widget_s widget, ...
        long plot_color, ...
        long x_zoom, ...
        long p_plot, ...
        byte invert_y)


    ' widget types
    OBJ_NONE        = 0                         ' none/not defined
    OBJ_WINDOW      = 1
    OBJ_BUTTON      = 2
    OBJ_TEXT_LABEL  = 3
    OBJ_PROGRESS_BAR= 4
    OBJ_BATT_GAUGE  = 5
    OBJ_DIGI_PLOT   = 100


pub get_ex(^widget_s ow): c
' Get the ending X coordinate of the button, based on its starting coord and width
'   btn:    button (pointer to button_s struct)
    return (ow.x + ow.w)-1


pub get_ey(^widget_s ow): c
' Get the ending Y coordinate of the button, based on its starting coord and height
'   ow:    button (pointer to button_s struct)
    return (ow.y + ow.h)-1


pub get_sx(^widget_s ow): c
' Get the ending X coordinate of the button, based on its starting coord and width
'   ow:    button (pointer to button_s struct)
    return ow.x


pub get_sy(^widget_s ow): c
' Get the ending X coordinate of the button, based on its starting coord and width
'   ow:    button (pointer to button_s struct)
    return ow.y


pub set_bgcolor(^widget_s ow, c)
' Set widget background color
'   ow:     widget (pointer to widget_s struct)
'   c:      color
    ow.bgcolor := c


pub set_dims(^widget_s ow, w, h)
' Set widget dimensions
'   ow:     widget (pointer to widget_s struct)
'   w, h:   dimensions (pixels)
    ow.w := w
    ow.h := h


pub set_fgcolor(^widget_s ow, c)
' Set widget foreground color
'   ow:     widget (pointer to widget_s struct)
'   c:      color
    ow.fgcolor := c


pub set_parent_obj(^widget_s ow, p)
' Set widget parent object
'   ow:     widget (pointer to widget_s struct)
'   p:      parent object (pointer to object struct)
    ow.parent := p


pub set_posxy(^widget_s ow, x, y)
' Set widget upper-left position
'   ow:     widget (pointer to widget_s struct)
'   x, y:   position (pixels)
    ow.x := x
    ow.y := y


pub set_touch_id(^widget_s ow, i)
' Set widget touchscreen event/touch ID
'   ow:     widget (pointer to widget_s struct)
'   i:      touch ID (byte)
    ow.touch_id := i


pub set_type(^widget_s ow, t)
' Set widget type
'   ow:     widget (pointer to widget_s struct)
'   t:      widget type (long)
    ow.type := t


pub screen_pos(^widget_s ow): x, y | ^window_s pwin
' Get a widget's absolute screen position
'   ow:         widget (pointer to widget_s struct)
'   Returns:    x, y coordinates (pixels)
    [pwin] := ow.parent
    x := pwin.widget.x + ow.x                   ' base widget coordinates off of the
    y := pwin.widget.y + ow.y                   '   parent window's coordinates


pub screen_pos_dims(^widget_s ow): x, y, w, h | ^window_s pwin
' Get a widget's absolute screen position and dimensions
'   ow:         widget (pointer to widget_s struct)
'   Returns:    x, y coordinates, w, h dimensions (pixels)
    [pwin] := ow.parent
    x := pwin.widget.x + ow.x                   ' base widget coordinates off of the
    y := pwin.widget.y + ow.y                   '   parent window's coordinates
    w := ow.w
    h := ow.h


pub touch_id(^widget_s ow): i
' Get a widget's touch ID
'   ow:         widget (pointer to widget_s struct)
'   Returns:    touch ID
    return ow.touch_id


pub widget_event(^widget_s ow): e
' Get a widget's event flags
'   ow:         widget (pointer to widget_s struct)
'   Returns:    event flags (bitmap)
    return ow.event


pub widget_h(^widget_s ow): h
' Get a widget's height
'   ow:         widget (pointer to widget_s struct)
'   Returns:    height (pixels)
    return ow.h


pub widget_w(^widget_s ow): w
' Get a widget's width
'   ow:         widget (pointer to widget_s struct)
'   Returns:    width (pixels)
    return ow.w


dat
