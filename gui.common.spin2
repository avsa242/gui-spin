{Spin2_v45}

con

    ' display driver API requirements
    %interface dispdrv_i(
        pub box(x1, y1, x2, y2, c, f)
        pub fgcolor(c)
        pub hline(y, xs, len, c)
        pub line(x1, y1, x2, y2, c)
        pub newline()
        pub plot(x, y, c)
        pub pos_xy(x, y)
        pub puts(p_str)
        pub vline(x, ys, len, c)
    )

    ' terminal driver API requirements
    %interface termdrv_i(
        pub clear_line()
        pub newline()
        pub pos_x(x)
        pub pos_xy(x, y)
        pub puts(p_str)
    )


    ' configuration structure used by all widgets
    struct widget_s( ...
        word x, y, w, h, ...
        byte touch_id, ...
        long bgcolor, fgcolor)



' Text windows
#ifndef TXT_LINE_MAX_LEN
# define TXT_LINE_MAX_LEN   80
#endif

#ifndef TEXTWIN_MAX_LINES
# define TEXTWIN_MAX_LINES  5
#endif

    ' line-buffer
    struct txt_line_s( byte text[TXT_LINE_MAX_LEN] )

    ' line-buffer window
    struct textwin_s(...
        widget_s widget, ...
        byte current_line, ...
        byte lines, ...
        txt_line_s line[TEXTWIN_MAX_LINES])
' --

' generic window
    struct win_cfg_s(...
        widget_s widget, ...
        long p_title_str, ...
        long p_disp)


dat
