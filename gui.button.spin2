#include "gui.common.spin2"

con

    ' limits
    MAX_BUTTONS = 16

    ' button states
    UP          = 0
    DOWN        = 1
    PUSHED      = 1


var

    button_s    button[MAX_BUTTONS]
    byte        _nr_buttons


pub create(^window_s pwin, x, y, w, h, fw, fh, p_txt): i | wp
' Create a button object
'   pwin:   parent window (pointer to window_s struct)
'   x, y:   button upper-left position (pixels)
'   w, h:   button dimensions (pixels)
'   fw, fh: button text font dimensions (pixels)
'   p_txt:  button text (pointer to string)
'   Returns:
'           button handle on success (pointer)
'           0 on failure (exceeded parent window's maximum number of objects,
'                           or this object's maximum number of buttons)
    if ( (pwin.nr_obj < MAX_WIN_OBJS ) and (_nr_buttons < MAX_BUTTONS) )
        i := @button[_nr_buttons]
        wp := @button[_nr_buttons].widget

        set_type(wp,            OBJ_BUTTON)
        set_parent_obj(wp,      @pwin)
        set_bgcolor(wp,         pwin.widget.bgcolor)
        set_fgcolor(wp,         pwin.widget.fgcolor)
        set_dims(wp,            w, h)
        set_posxy(wp,           x, y)
        set_font_sz(i,          fw, fh)
        set_text(i,             p_txt)

        pwin.object[pwin.nr_obj] := i
        pwin.nr_obj++
        _nr_buttons++
        return

    return 0


pub destroy(^button_s btn): s
' Destroy a button object
'   plot:       button (pointer to button_s struct)
'   Returns:    number of buttons before destruction
    if ( (_nr_buttons > 0) and (btn.widget.type == OBJ_BUTTON) )
    ' do some basic safeguards before just clearing memory
        btn~
        s := _nr_buttons
        _nr_buttons--
        return

    return false


pub draw(^button_s btn) | ^window_s win, ^dispdrv_i disp, sx, sy, ex, ey
' Draw a button
'   btn:    button (pointer to button_s struct)
    [win] := btn.widget.parent                  ' get handle on parent window
    [disp] := win.p_disp                        ' get the display driver interface from the parent
    sx := win.widget.x+btn.widget.x
    sy := win.widget.y+btn.widget.y
    ex := sx + btn.widget.w-1
    ey := sy + btn.widget.h-1

    case btn.state
        UP:
            disp.box(   sx, sy, ...
                        ex, ey, ...
                        btn.widget.fgcolor, ...
                        false)
            disp.fgcolor(btn.widget.fgcolor)
        DOWN:
            disp.box(   sx, sy, ...
                        ex, ey, ...
                        btn.widget.bgcolor, ...
                        false)
            disp.box(   sx+1, sy+1, ...
                        ex-1, ey-1, ...
                        btn.widget.fgcolor, ...
                        true)
            disp.fgcolor(btn.widget.bgcolor)

    if ( text_len(@btn) )
        disp.pos_xy(    (sx+(btn.widget.w/2))-((text_len(@btn) * btn.font_w)/2), ...
                        sy+(btn.widget.h/2)-(btn.font_h/2) )
        disp.puts(btn.p_text)


pub draw_to_disp(^dispdrv_i disp, ^button_s btn)
' Draw a button
'   disp:   display driver interface (pointer to driver object, e.g., @lcd)
'   btn:    button (pointer to button_s struct)
    disp.box(   btn.widget.x, btn.widget.y, ...
                btn.widget.x+btn.widget.w-1, btn.widget.y+btn.widget.h-1, ...
                btn.widget.fgcolor, ...
                false)

    if ( text_len(@btn) )
        disp.pos_xy(    (btn.widget.x+(btn.widget.w/2))-((text_len(@btn) * btn.font_w)/2), ...
                        btn.widget.y+(btn.widget.h/2)-(btn.font_h/2) )
        disp.fgcolor(btn.widget.fgcolor)
        disp.puts(btn.p_text)


pub min_height(^button_s btn): w
' Get the minimum height of a button, considering its font size
'   btn:    button (pointer to button_s struct)
    return btn.font_h


pub min_width(^button_s btn): w
' Get the minimum width of a button, considering its font size and length of text
'   btn:    button (pointer to button_s struct)
    return text_len(@btn) * btn.font_w


pub ptr_widget(^button_s btn): ^widget_s ow
' Get pointer to a button's widget configuration
'   btn:        button (pointer to button_s struct)
'   Returns:    pointer to widget_s struct
    return @btn.widget


pub set_callback(^button_s btn, p_func)
' Set a button's callback function
'   btn:    button (pointer to button_s struct)
'   p_func: pointer to method/function
    btn.callback := p_func


pub set_font_sz(^button_s btn, w, h)
' Set button text font size
'   btn:    button (pointer to button_s struct)
'   w, h:   font size (pixels)
    btn.font_w := w
    btn.font_h := h


pub set_state(^button_s btn, s)
' Set button state
'   btn:    button (pointer to button_s struct)
'   s:      button state
    btn.state := s


pub set_text(^button_s btn, p_text)
' Set button text
'   btn:    button (pointer to button_s struct)
'   p_text: text string (pointer)
    btn.p_text := p_text
    ifnot ( btn.widget.w )
    ' use button text to set the button's width, if it hasn't yet been set
        btn.widget.w := (strsize(p_text)+1) * btn.font_w


pub text_len(^button_s btn): len
' Get the length of the text string pointed to by the button definition
'   btn:    button (pointer to button_s struct)
    len := strsize(btn.p_text)



dat
