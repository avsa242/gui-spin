{Spin2_v45}


#include "widget-common.spin2"

con

    WIDGET_TYPE         = TYPE_BUTTON

    MAX_BUTTONS         = 16
    MAX_OBJECTS         = 1

    ' option flags
    FLAG_DRAW_OUTLINE   = 1 << 0
    FLAG_DRAW_FILL      = 1 << 1
    FLAG_DRAW_CORNERS   = 1 << 2


    ' default settings
    DEF_WIDTH           = 128
    DEF_HEIGHT          = 64
    DEF_BORDER_COLOR    = 1
    DEF_FILL_COLOR      = 0
    DEF_FLAGS           = FLAG_DRAW_OUTLINE | FLAG_DRAW_FILL | FLAG_DRAW_CORNERS


#include "gui-common.spin2"
#include "container-common.spin2"


obj

    window: "gui.window"


con

    struct window_s = window.window_s


    struct button_s(...
        widget_s widget, ...
        container_s container, ...
        long border_color, ...
        long fill_color, ...
        byte state)


var

    button_s    button[MAX_BUTTONS]
    byte        _nr_buttons


pub border_color(^button_s btn): c
' Get a button's current border color
'   btn:        pointer to button_s struct
'   Returns:    border color
    return btn.border_color


pub create(^window_s win, w=0, h=0): ^button_s btn
' Create a button
'   win:        parent window (pointer to window_s struct)
'   w, h:       dimensions of button (optional; sets DEF_WIDTH and DEF_HEIGHT if not specified)
'   Returns:    pointer to button struct on success
'               0 on failure (button array full)
    if ( _nr_buttons < MAX_BUTTONS )
        if ( w < 1 )
            w := DEF_WIDTH
        if ( h < 1 )
            h := DEF_HEIGHT

        [btn] := @button[_nr_buttons]
        btn.widget.x := win.container.cursor.x  ' position at parent window's current cursor
        btn.widget.y := win.container.cursor.y
        btn.widget.w := w
        btn.widget.h := h
        btn.widget.abs_x := win.widget.abs_x+btn.widget.x
        btn.widget.abs_y := win.widget.abs_y+btn.widget.y
        btn.widget.type := TYPE_BUTTON
        btn.widget.p_disp := win.widget.p_disp
        btn.widget.parent := [win]              ' save a reference to the parent window
        btn.widget.draw := @draw

        btn.container.cursor.x := 0
        btn.container.cursor.y := 0

        btn.state := 1
        btn.widget.flags := DEF_FLAGS

        longfill(@btn.container.buffer, 0, MAX_OBJECTS)
        btn.container.count := 0

        _nr_buttons++
        DEBUG("[button] create: x=", udec_(btn.widget.x), " y=", udec_(btn.widget.y), " w=", udec_(btn.widget.w), " h=", udec_(btn.widget.h) )

        return

    DEBUG("[button] create: error; out of memory")
    return 0


pub draw(p_btn=0) | ^button_s btn, ^dispdrv_i disp, ^window_s pwin, sx, sy, ex, ey
' Draw a button
'   p_btn:  pointer to button struct (optional if called indirectly via the struct itself)
    ifnot ( p_btn )                             ' get the button's pointer from the parent struct,
        [btn] := %self                          '   if none was specified
    else
        [btn] := p_btn

    [disp] := btn.widget.p_disp
    [pwin] := btn.widget.parent

    sx := btn.widget.x
    sy := btn.widget.y
    ex := (btn.widget.x + btn.widget.w-1)
    ey := btn.widget.y + btn.widget.h-1

    if ( btn.widget.flags & FLAG_DRAW_OUTLINE )
        if ( btn.widget.flags & FLAG_DRAW_CORNERS )
            disp.box(sx, sy, ex, ey, btn.border_color, false)
        else
            disp.hline(sy, sx+1, ex-sx-1, btn.border_color)
            disp.hline(ey, sx+1, ex-sx-1, btn.border_color)
            disp.vline(sx, sy+1, ey-sy-1, btn.border_color)
            disp.vline(ex, sy+1, ey-sy-1, btn.border_color)
    if ( btn.widget.flags & FLAG_DRAW_FILL )
        disp.box(sx+1, sy+1, ex-1, ey-1, btn.fill_color, true)


pub fill_color(^button_s btn): c
' Get a button's current fill color
'   btn:        pointer to button_s struct
'   Returns:    fill color
    return btn.fill_color


pub obj_attach(^button_s btn, p_obj): n | ^widget_s wp, ex, ey                                          
' Attach a GUI object to a button's tree
'   btn:        pointer to button struct to attach object to
'   p_obj:      pointer to object struct
'   Returns:    index in object tree array on success
'               -1 on failure (object array is full)
    n := btn.container.count
    if ( n < MAX_OBJECTS )
        [wp] := p_obj
        DEBUG("[button] obj_attach: type=", zstr_(lookup(wp.type: @"TYPE_WINDOW", @"TYPE_BUTTON", @"TYPE_TEXTLABEL", @"TYPE_PROGRESSBAR") ), " w=", udec_(wp.w) )
        DEBUG("[button] obj_attach: cursor before ", udec_(btn.container.cursor.x), udec_(btn.container.cursor.y) )
        ' modify the widget's position according to its layout gravity
        case wp.layout_gravity
            GRAV_UPPER_LEFT:
                ' no change
                wp.x := btn.container.cursor.x
                wp.y := btn.container.cursor.y
            GRAV_CENTER_TOP:
                wp.x := (btn.widget.w/2)-(wp.w/2)
            GRAV_UPPER_RIGHT:
                wp.x := btn.widget.w-wp.w
            GRAV_CENTER_RIGHT:
                wp.x := btn.widget.w-wp.w
                wp.y := (btn.widget.h/2)-(wp.h/2)
            GRAV_LOWER_RIGHT:
                wp.x := btn.widget.w-wp.w
                wp.y := btn.widget.h-wp.h
            GRAV_CENTER_BOTTOM:
                wp.x := (btn.widget.w/2)-(wp.w/2)
                wp.y := btn.widget.h-wp.h
            GRAV_LOWER_LEFT:
                wp.y := btn.widget.h-wp.h
            GRAV_CENTER_LEFT:
                wp.y := (btn.widget.h/2)-(wp.h/2)
            GRAV_CENTER:
                wp.x := (btn.widget.w/2)-(wp.w/2)
                wp.y := (btn.widget.h/2)-(wp.h/2)

        ' move the container cursor by the size of the object,
        '   wrapping around to the left/top if needed
        btn.container.cursor.x += wp.w
        if ( btn.container.cursor.x > (btn.widget.x+btn.widget.w-1) )
            DEBUG("[button] obj_attach: cursor.x=", udec_(btn.container.cursor.x), "; wrapping")
            btn.container.cursor.x := 0
            btn.container.cursor.y += wp.h
            if ( btn.container.cursor.y > (btn.widget.y+btn.widget.h-1) )
                DEBUG("[button] obj_attach: cursor.y=", udec_(button.container.cursor.y), "; wrapping")
                btn.container.cursor.y := 0

        btn.container.buffer[n] := p_obj        ' add the object's pointer

        btn.container.count++
        DEBUG("[button] obj_attach: cursor after ", udec_(btn.container.cursor.x), udec_(btn.container.cursor.y) )
        return

    return -1


pub set_border_color(^button_s btn, c)
' Set a button's border/outline color
'   btn:    pointer to button struct
'   c:      color
    btn.border_color := c


pub set_fill_color(^button_s btn, c)
' Set a button's interior fill color
'   btn:    pointer to button struct
'   c:      color
    btn.fill_color := c


dat
