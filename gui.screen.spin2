{Spin2_v45}


con

    MAX_SCREENS = 1
    MAX_OBJECTS = 16


#include "widget-common.spin2"
#include "gui-common.spin2"
#include "container-common.spin2"


con

    struct screen_s(...
        long p_disp, ...
        word width, height, ...
        container_s container, ...
        word grid_x, ...
        word grid_y)


var

    screen_s    screen[MAX_SCREENS]


pub create(^dispdrv_i disp, p_setup): i

    screen.p_disp := [disp]
    screen.width := word[p_setup+8]
    screen.height := word[p_setup+10]
    longfill(@screen.container.buffer, 0, MAX_OBJECTS)
    screen.container.count := 0

    DEBUG("[gui.screen] create() screen size ", udec_(screen.width), "x", udec_(screen.height))
    return @screen[0]


pub obj_attach(^screen_s scr, p_obj, x=-1, y=-1): n | ^widget_s wp
' Attach a window to a screen's object buffer
'   src:        pointer to screen struct to attach window to
'   p_obj:      pointer to object (window) struct
'   x, y:       position of object (optional; default is the object's gravity setting or
'               the current cursor position)
'   Returns:    index in object tree array on success
'               -1 on failure (object array is full)

    n := screen.container.count
    if ( n < MAX_OBJECTS )
        [wp] := p_obj
        if ( wp.type <> TYPE_WINDOW )
            DEBUG("[gui.screen] obj_attach: error: type <> TYPE_WINDOW")
            return -1

        if ( (x == -1) and (y == -1) )
            ' modify the widget's position according to its layout gravity
            case wp.layout_gravity
                GRAV_UPPER_LEFT:
                    wp.x := 0
                    wp.y := 0
                GRAV_CENTER_TOP:
                    wp.x := (scr.width/2)-(wp.w/2)
                GRAV_UPPER_RIGHT:
                    wp.x := scr.width-wp.w
                GRAV_CENTER_RIGHT:
                    wp.x := scr.width-wp.w
                    wp.y := (scr.height/2)-(wp.h/2)
                GRAV_LOWER_RIGHT:
                    wp.x := scr.width-wp.w
                    wp.y := scr.height-wp.h
                GRAV_CENTER_BOTTOM:
                    wp.x := (scr.width/2)-(wp.w/2)
                    wp.y := scr.height-wp.h
                GRAV_LOWER_LEFT:
                    wp.y := scr.height-wp.h
                GRAV_CENTER_LEFT:
                    wp.y := (scr.height/2)-(wp.h/2)
                GRAV_CENTER:
                    wp.x := (scr.width/2)-(wp.w/2)
                    wp.y := (scr.height/2)-(wp.h/2)
                other:
                    ' no gravity setting; use the cursor position
                    wp.x := scr.container.cursor.x
                    wp.y := scr.container.cursor.y
        else
            ' manually place
            wp.x := x
            wp.y := y

        DEBUG("[gui.screen] obj_attach: cursor before ", udec_(screen.container.cursor.x), udec_(screen.container.cursor.y) )
        screen.container.buffer[n] := p_obj        ' add the object's pointer
        screen.container.count++

        ' move the window cursor by the size of the obj, wrapping around to the left (or top)
        screen.container.cursor.x += (wp.w+screen.grid_x)

        if ( screen.container.cursor.x > (screen.width-1) )
            DEBUG("[gui.screen] obj_attach: cursor.x=", udec_(screen.container.cursor.x), "; wrapping")
            screen.container.cursor.x := screen.grid_x
            screen.container.cursor.y += wp.h+screen.grid_y
        if ( screen.container.cursor.y > (screen.height-1) )
            DEBUG("[gui.screen] obj_attach: cursor.y=", udec_(screen.container.cursor.y), "; wrapping")
            screen.container.cursor.x := screen.grid_x
            screen.container.cursor.y := screen.grid_y

        DEBUG("[gui.screen] obj_attach ", udec_(n), ": cursor after ", udec_(screen.container.cursor.x), udec_(screen.container.cursor.y) )
        return

    DEBUG("[gui.screen] obj_attach: screen ", uhex_(@screen), " error: out of memory (object buffer full)")
    return -1


dat
