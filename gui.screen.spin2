{Spin2_v45}


con

    MAX_SCREENS = 1
    MAX_OBJECTS = 16


#include "widget-common.spin2"
#include "gui-common.spin2"
#include "container-common.spin2"


con

    struct screen_s(...
        long p_disp, ...
        word width, height, ...
        container_s container, ...
        word grid_x, ...
        word grid_y)


var

    screen_s    screen[MAX_SCREENS]
    byte        _nr_screens


pub create(^dispdrv_i disp, p_setup): i

    if ( _nr_screens < MAX_SCREENS )
        i := @screen[_nr_screens]
        screen[_nr_screens].p_disp := [disp]
        screen[_nr_screens].width := word[p_setup+8]
        screen[_nr_screens].height := word[p_setup+10]
        longfill(@screen[_nr_screens].container.buffer, 0, MAX_OBJECTS)
        screen[_nr_screens].container.count := 0

        DEBUG("[gui.screen] create() screen size ", udec_(screen.width), "x", udec_(screen.height))
        _nr_screens++
        return

    DEBUG("[gui.screen] create(): error: out of memory")
    return 0


pub obj_attach(^screen_s scr, p_obj, x=-1, y=-1): n | ^widget_s wp
' Attach a window to a screen's object buffer
'   src:        pointer to screen struct to attach window to
'   p_obj:      pointer to object (window) struct
'   x, y:       position of object (optional; default is the object's gravity setting or
'               the current cursor position)
'   Returns:    index in object tree array on success
'               -1 on failure (object array is full)

    n := scr.container.count
    if ( n < MAX_OBJECTS )
        [wp] := p_obj
        if ( wp.type <> TYPE_WINDOW )
            DEBUG("[gui.screen] obj_attach: error: type <> TYPE_WINDOW")
            return -1

        wp.parent := [scr]
        wp.p_disp := scr.p_disp

        ' handle positioning of widget:
        if ( (x == -1) and (y == -1) )
            ' position not explicitly specified, so modify the widget's position
            '   according to its layout gravity
            case wp.layout_gravity
                GRAV_UPPER_LEFT:
                    wp.x := 0
                    wp.y := 0
                GRAV_CENTER_TOP:
                    wp.x := (scr.width/2)-(wp.w/2)
                GRAV_UPPER_RIGHT:
                    wp.x := scr.width-wp.w
                GRAV_CENTER_RIGHT:
                    wp.x := scr.width-wp.w
                    wp.y := (scr.height/2)-(wp.h/2)
                GRAV_LOWER_RIGHT:
                    wp.x := scr.width-wp.w
                    wp.y := scr.height-wp.h
                GRAV_CENTER_BOTTOM:
                    wp.x := (scr.width/2)-(wp.w/2)
                    wp.y := scr.height-wp.h
                GRAV_LOWER_LEFT:
                    wp.y := scr.height-wp.h
                GRAV_CENTER_LEFT:
                    wp.y := (scr.height/2)-(wp.h/2)
                GRAV_CENTER:
                    wp.x := (scr.width/2)-(wp.w/2)
                    wp.y := (scr.height/2)-(wp.h/2)
                other:
                    ' no gravity setting; use the cursor position
                    wp.x := scr.container.cursor.x
                    wp.y := scr.container.cursor.y
        else
            ' position was specified, so manually place it
            wp.x := x
            wp.y := y

        DEBUG("[gui.screen] obj_attach: cursor before ", udec_(scr.container.cursor.x), udec_(scr.container.cursor.y) )
        scr.container.buffer[n] := p_obj        ' add the object's pointer
        scr.container.count++

        ' move the window cursor by the size of the obj, wrapping around to the left (or top)
        scr.container.cursor.x += (wp.w+scr.grid_x)

        if ( scr.container.cursor.x > (scr.width-1) )
            DEBUG("[gui.screen] obj_attach: cursor.x=", udec_(scr.container.cursor.x), "; wrapping")
            scr.container.cursor.x := scr.grid_x
            scr.container.cursor.y += wp.h+scr.grid_y
        if ( scr.container.cursor.y > (scr.height-1) )
            DEBUG("[gui.screen] obj_attach: cursor.y=", udec_(scr.container.cursor.y), "; wrapping")
            scr.container.cursor.x := scr.grid_x
            scr.container.cursor.y := scr.grid_y

        DEBUG("[gui.screen] obj_attach ", udec_(n), ": cursor after ", udec_(scr.container.cursor.x), udec_(scr.container.cursor.y) )
        return

    DEBUG("[gui.screen] obj_attach: screen ", uhex_(@scr), " error: out of memory (object buffer full)")
    return -1


pub obj_detach(^screen_s scr, p_obj): o
' Detach an object from a screen (by pointer to object)
'   scr:        pointer to screen struct
'   p_obj:      pointer to object struct to detach
'   Returns:    array index of object within screen on success
'               -1 on failure (object with that pointer not found)
    repeat o from 0 to scr.container.count-1    ' find the object's pointer in the tree
        if ( scr.container.buffer[o] == p_obj ) ' matching pointer?
            if ( o < (MAX_OBJECTS-1) )          ' pack pointers downwards if we're not at the end
                longmove(   @scr.container.buffer[o], ...
                            @scr.container.buffer[o+1], ...
                            MAX_OBJECTS-1-o)
            scr.container.buffer[MAX_OBJECTS-1] := 0
            scr.container.count--
            return o

    return -1                                   ' pointer not found in the tree


dat
