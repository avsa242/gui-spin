{
----------------------------------------------------------------------------------------------------
    Filename:       gui.progressbar.spin2
    Description:    Progress bar GUI widget
    Author:         Jesse Burt
    Started:        Sep 5, 2026
    Updated:        Oct 25, 2026
    Copyright (c) 2026 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------

    Requirements:
        a display driver that provides the following interfaces:
            pub box(sx, sy, ex, ey, color, fill_flag)
            pub line(sx, sy, ex, ey, color)
        a window to draw the progress bar to (window_s type from gui.window.spin2)
}
{Spin2_v45}


#include "widget-common.spin2"

con

    WIDGET_TYPE         = TYPE_PROGRESSBAR

    ' limits
    MAX_PROGRESS_BARS   = 1

    ' option flags
    FLAG_DRAW_OUTLINE   = 1 << 0
    FLAG_DRAW_CORNERS   = 1 << 2

    ' defaults settings
    DEF_WIDTH           = 128
    DEF_HEIGHT          = 64
    DEF_BORDER_COLOR    = 1
    DEF_FILL_COLOR      = 0
    DEF_FLAGS           = 0


#include "gui-common.spin2"


obj

    window: "gui.window"
    button: "gui.button"


con

    struct window_s = window.window_s
    struct button_s = button.button_s

    struct progressbar_s(...
        widget_s    widget, ...
        long        border_color, ...
        long        bar_color, ...
        long        bgcolor, ...
        word        value)

var

    progressbar_s   prog_bar[MAX_PROGRESS_BARS]
    progressbar_s   defaults

    byte            _nr_progbars


pub create(p_parent, w=0, h=0): ^progressbar_s p | ct
' Create a progress bar object (use currently set defaults)
'   pwin:   parent window (pointer to window_s struct)
'   Returns:
'           progress bar handle on success (pointer)
'           0 on failure (exceeded parent window's maximum number of obects,
'                           or this object's maximum number of buttons)
    if ( _nr_progbars < MAX_PROGRESS_BARS )
        if ( w < 1 )
            w := DEF_WIDTH
        if ( h < 1 )
            h := DEF_HEIGHT
        [p] := @prog_bar[_nr_progbars]

        ct := long[p_parent][0]                 ' read container type
        if ( ct == TYPE_WINDOW )                ' get coords from parent container
            p.widget.p_disp := window_s[p_parent].widget.p_disp
        elseif ( ct == TYPE_BUTTON )
            p.widget.p_disp := button_s[p_parent].widget.p_disp

        p.widget.type := TYPE_PROGRESSBAR
        p.widget.w := w
        p.widget.h := h
        p.widget.parent := p_parent
        p.widget.draw := @draw

        _nr_progbars++

        return

    return 0


pub draw(p_pbar=0) | ^progressbar_s pbar, ^window_s win, ^dispdrv_i disp, sx, sy, ex, ey, p, l, s, c
' Draw a progress bar
'   pbar:   progress bar data (pointer to progressbar_s struct)
    ifnot ( p_pbar )                             ' get the button's pointer from the parent struct,
        [pbar] := %self                          '   if none was specified
    else
        [pbar] := p_pbar

    [disp] := pbar.widget.p_disp                ' get the display driver interface from the parent
    [win] := pbar.widget.parent                 ' get handle on parent window

    sx := pbar.widget.x
    sy := pbar.widget.y
    ex := sx + pbar.widget.w-1
    ey := sy + pbar.widget.h-1
    p := (0 #> pbar.value <# 100)
    l := (ex-sx)-2                              ' fill length (account for bar outline too)

    ' draw the outline
    if ( pbar.widget.flags & FLAG_DRAW_OUTLINE )
        if ( pbar.widget.flags & FLAG_DRAW_CORNERS )
            disp.box(sx, sy, ex, ey, pbar.border_color, false)
        else
            disp.hline(sy, sx+1, ex-sx-1, pbar.border_color)
            disp.hline(ey, sx+1, ex-sx-1, pbar.border_color)
            disp.vline(sx, sy+1, ey-sy-1, pbar.border_color)
            disp.vline(ex, sy+1, ey-sy-1, pbar.border_color)

    ' draw the progress bar itself
    if ( p )                                    ' only draw if percent > 0
        s := (p * l) / 100                      ' scaled bar/filled length
        disp.box(sx+1, sy+1, sx+1+s, ey-1, pbar.bar_color, true)
        disp.box(sx+1+s, sy+1, ex-1, ey-1, pbar.bgcolor, true)


pub set_border_color(^progressbar_s pbar, c)
' Set progressbar border/outline color
'   pbar:   progress bar (pointer to progressbar_s struct)
'   c:      color
    pbar.border_color := c


pub set_bar_color(^progressbar_s pbar, c)
' Set progressbar border/outline color
'   pbar:   progress bar (pointer to progressbar_s struct)
'   c:      color
    pbar.bar_color := c


pub set_bgcolor(^progressbar_s pbar, c)
' Set progressbar background color
'   pbar:   progress bar (pointer to progressbar_s struct)
'   c:      color
    pbar.bgcolor := c


pub set_value(^progressbar_s pbar, v)
' Set progress bar percentage
'   pbar:   progress bar (pointer to progressbar_s struct)
'   v:      percentage (0..100)
    pbar.value := v


dat
