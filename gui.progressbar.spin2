{
----------------------------------------------------------------------------------------------------
    Filename:       gui.progressbar.spin2
    Description:    Progress bar GUI widget
    Author:         Jesse Burt
    Started:        Sep 5, 2026
    Updated:        Sep 8, 2026
    Copyright (c) 2026 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------

    Requirements:
        a display driver that provides the following interfaces:
            pub box(sx, sy, ex, ey, color, fill_flag)
            pub line(sx, sy, ex, ey, color)
        a window to draw the progress bar to (window_s type from gui.window.spin2)
}

#include "gui.common.spin2"


con

    ' limits
    MAX_PROGRESS_BARS   = 1


var

    progressbar_s   prog_bar[MAX_PROGRESS_BARS]
    progressbar_s   defaults

    byte            _nr_progbars


pub create(^window_s pwin): ^progressbar_s i | ^widget_s wp
' Create a progress bar object (use currently set defaults)
'   pwin:   parent window (pointer to window_s struct)
'   Returns:
'           progress bar handle on success (pointer)
'           0 on failure (exceeded parent window's maximum number of obects,
'                           or this object's maximum number of buttons)
    if ( (pwin.nr_obj < MAX_WIN_OBJS) and (_nr_progbars < MAX_PROGRESS_BARS) )
        [i] := @prog_bar[_nr_progbars]          ' cache local pointers to progressbar object struct
        [wp] := @prog_bar[_nr_progbars].widget  '   and widget sub-struct

        ' set up widget basic configuration
        bytemove(@i, @defaults, sizeof(progressbar_s) )
        set_type(@wp,       OBJ_PROGRESS_BAR)
        set_parent_obj(@wp, @pwin)

        ' check if the label will fit at the current window cursor
        if ( ((pwin.cursor.x + wp.w) < (pwin.widget.x+pwin.widget.w-1)) and ...
             ((pwin.cursor.y + wp.h) < (pwin.widget.y+pwin.widget.h-1)) )
            set_posxy(@wp,  pwin.cursor.x, pwin.cursor.y)

            ' move the window's cursor for the next object
            pwin.cursor.x += wp.w+pwin.grid_spacing_x
            if ( pwin.cursor.x > (pwin.widget.x+pwin.widget.w-1) )
                pwin.cursor.x := (pwin.widget.x+pwin.grid_spacing_x)
                pwin.cursor.y += wp.h+pwin.grid_spacing_y
            if ( pwin.cursor.y > (pwin.widget.y+pwin.widget.h-1) )
                pwin.cursor.y := pwin.widget.y

        pwin.object[pwin.nr_obj] := @i
        pwin.nr_obj++
        _nr_progbars++
        return

    return 0


pub create_explicit(^window_s pwin, x, y, w, h): i | wp
' Create a progress bar object
'   pwin:   parent window (pointer to window_s struct)
'   x, y:   button upper-left position (pixels)
'   w, h:   progress bar dimensions (pixels; optional - defaults will be used if unspecified)
'   Returns:
'           progress bar handle on success (pointer)
'           0 on failure (exceeded parent window's maximum number of obects,
'                           or this object's maximum number of buttons)                                 
    if ( (pwin.nr_obj < MAX_WIN_OBJS) and (_nr_progbars < MAX_PROGRESS_BARS) )
        i := @prog_bar[_nr_progbars]
        wp := @prog_bar[_nr_progbars].widget    ' widget struct pointer

        ' set up widget basic configuration
        set_type(wp,        OBJ_PROGRESS_BAR)
        set_parent_obj(wp,  @pwin)
        set_posxy(wp,       x, y)
        set_dims(wp,        w, h)
        set_bgcolor(wp,     pwin.widget.bgcolor)' inherit widget colors from parent
        set_fgcolor(wp,     pwin.widget.fgcolor)
        set_outline_color(i,pwin.widget.bgcolor)
        pwin.object[pwin.nr_obj] := i
        pwin.nr_obj++
        _nr_progbars++
        return

    return 0


pub destroy(^progressbar_s pbar): s
' Destroy a progress bar object
'   plot:       progress bar (pointer to progressbar_s struct)
'   Returns:    number of progress bars before destruction
    if ( (_nr_progbars > 0) and (pbar.widget.type == OBJ_PROGRESS_BAR) )
    ' do some basic safeguards before just clearing memory
        pbar~
        s := _nr_progbars
        _nr_progbars--
        return

    return false


pub draw(^progressbar_s pbar) | ^window_s win, ^dispdrv_i disp, sx, sy, ex, ey, p, l, s, c
' Draw a progress bar
'   pbar:   progress bar data (pointer to progressbar_s struct)
    [win] := pbar.widget.parent                 ' get handle on parent window
    [disp] := win.p_disp                        ' get the display driver interface from the parent

    sx := win.widget.x+pbar.widget.x+1
    sy := win.widget.y+pbar.widget.y+1
    ex := sx + pbar.widget.w-1
    ey := sy + pbar.widget.h-1
    p := (0 #> pbar.state <# 100)
    l := (ex-sx)-2                              ' fill length (account for bar outline too)

    ' draw the outline
    disp.box(sx, sy, ex, ey, pbar.outline_color, false)

    ' draw the progress bar itself
    if ( p )                                    ' only draw if percent > 0
        s := (p * l) / 100                      ' scaled bar/filled length
        disp.box(sx+1, sy+1, sx+1+s, ey-1, pbar.widget.fgcolor, true)
        disp.box(sx+1+s, sy+1, ex-1, ey-1, pbar.widget.bgcolor, true)

pub ptr_widget(^progressbar_s pbar): ^widget_s ow
' Get pointer to a progress bar's widget configuration
'   pbar:       progress bar (pointer to progressbar_s struct)
'   Returns:    pointer to widget_s struct
    return @pbar.widget


pub set_bar_color = set_fgcolor
' Set battery state of charge bar color


pub set_default_bgcolor(c)
' Set default background color for new progressbars
'   c:  color
    defaults.widget.bgcolor := c


pub set_default_fgcolor(c)
' Set default foreground color for new progressbars
'   c:  color
    defaults.widget.fgcolor := c


pub set_default_dims(w, h)
' Set default dimensions for new progressbars
    defaults.widget.w := w
    defaults.widget.h := h


pub set_default_outline_color(c)
' Set outline color for new progressbars
    defaults.outline_color := c


pub set_outline_color(^progressbar_s pbar, c)
' Set progressbar outline color
    pbar.outline_color := c


pub set_state(^progressbar_s pbar, s)
' Set progress bar percentage
'   s:  percentage (0..100)
    pbar.state := s


dat
