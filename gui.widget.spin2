{Spin2_v45}


con

    ' widget header
    struct widget_s(...
        long type, ...                          ' GUI widget type
        long p_disp, ...                        ' display driver pointer
        long parent, ...                        ' reference to parent widget/object
        long draw, ...                          ' draw function pointer
        long flags, ...                         ' draw flags/options
        long event, ...                         ' events
        word abs_x, abs_y, ...                  ' screen coordinates    xxx review: needed?
        word x, y, w, h, ...                    ' position, dimensions
        byte touch_id)

    ' widget types
    TYPE_WINDOW     = 1
    TYPE_BUTTON     = 2
    TYPE_TEXTLABEL  = 3


#include "gui-common.spin2"


pub obj_type(^widget_s obj_w): t
' Get a widget's type
'   obj_w:      pointer to widget struct
'   Returns:    widget type
    return obj_w.type


pub set_flags(^widget_s obj_w, f)
' Set a widget's flags/options
'   obj_w:  pointer to widget struct
'   f:      one or more flags to set
    obj_w.flags := f


pub set_touch_id(^widget_s obj_w, tid)
' Set a widget's touchscreen ID
    obj_w.touch_id := tid


pub set_widget_x(^widget_s obj_w, x)
' Set a widget's x-axis position
    obj_w.x := x


pub set_widget_y(^widget_s obj_w, y)
' Set a widget's y-axis position
    obj_w.y := y


pub widget_area(^widget_s obj_w): sx, sy, ex, ey
' Get the area occupied by a widget
'   obj_w:      pointer to widget struct
'   Returns:    starting and ending coordinates (4 longs)
    sx := obj_w.abs_x
    sy := obj_w.abs_y
    ex := obj_w.w-1
    ey := obj_w.h-1


dat
