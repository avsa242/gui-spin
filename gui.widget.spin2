{Spin2_v45}

#include "widget-common.spin2"
#include "gui-common.spin2"


pub height(^widget_s obj_w): h
' Get a widget's height
'   obj_w:      pointer to widget struct
'   Returns:    widget height
    return obj_w.h


pub obj_type(^widget_s obj_w): t
' Get a widget's type
'   obj_w:      pointer to widget struct
'   Returns:    widget type
    return obj_w.type


pub set_flags(^widget_s obj_w, f)
' Set a widget's flags/options
'   obj_w:  pointer to widget struct
'   f:      one or more flags to set
    obj_w.flags := f


pub set_layout_gravity(^widget_s obj_w, g)
' Set a widget's layout gravity (preferred alignment in parent)
'   obj_w:  pointer to widget struct
'   g:      location gravitated to/alignment to (see GRAV_ symbols)
    obj_w.layout_gravity := g


pub set_touch_id(^widget_s obj_w, tid)
' Set a widget's touchscreen ID
    obj_w.touch_id := tid


pub set_dims(^widget_s obj_w, w, h)
' Set a widget's dimensions
'   obj_w:      pointer to widget struct
'   w:          width (pixels)
'   h:          height (pixels)
    obj_w.w := w
    obj_w.h := h
    DEBUG("[widget] set_dims type=", zstr_(lookup(obj_w.type: @"TYPE_WINDOW", @"TYPE_BUTTON", @"TYPE_TEXTLABEL", @"TYPE_PROGRESSBAR") ), " w=", udec_(obj_w.w), " h=", udec_(obj_w.h) )


pub set_widget_x(^widget_s obj_w, x)
' Set a widget's x-axis position
    obj_w.x := x


pub set_widget_y(^widget_s obj_w, y)
' Set a widget's y-axis position
    obj_w.y := y


pub widget_area(^widget_s obj_w): sx, sy, ex, ey
' Get the area occupied by a widget
'   obj_w:      pointer to widget struct
'   Returns:    starting and ending coordinates (4 longs)
    sx := obj_w.abs_x
    sy := obj_w.abs_y
    ex := obj_w.w-1
    ey := obj_w.h-1


pub width(^widget_s obj_w): w
' Get a widget's width
'   obj_w:      pointer to widget struct
'   Returns:    widget width
    return obj_w.w


dat
