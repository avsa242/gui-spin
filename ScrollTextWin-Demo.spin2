{                                                                                                       
----------------------------------------------------------------------------------------------------
    Filename:       ScrollTextWin-Demo.spin2
    Description:    Demo of the scrollable text window
        * no window decorations
    Author:         Jesse Burt
    Started:        Aug 9, 2026
    Updated:        Aug 15, 2026
    Copyright (c) 2026 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------

    See gui.win-scrolltext.spin2 for usage instructions
}
{Spin2_v45}

con

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000


' set the maximum line length and number of lines
#define TXT_LINE_MAX_LEN    50
#define TEXTWIN_MAX_LINES   6
#pragma exportdef(TXT_LINE_MAX_LEN)
#pragma exportdef(TEXTWIN_MAX_LINES)


obj

    ser:    "com.serial.terminal.ansi"
    gui:    "gui.win-scrolltext"

#include "gui.common.spin2"


var

    textwin_s   window                          ' memory for the text window


pub main() | i

    setup()
    ser.clear()

    gui.set_active_window(@window)              ' tell the terminal I/O routines where to write

    window.widget.x := 5                        ' position the window in the terminal
    window.widget.y := 5

    i := 0
    repeat
        ' write text to the window (printable text only; all control chars except LF are ignored)
        ' a newline (or a line that overflows the max length) will move to the next line
        ' a newline past the last line will scroll the lines up (oldest line is gone)
        gui.printf(@"this is a test message #%d\n", i++)
        gui.draw_text_buffer(@window, @ser)


pub setup()

    ser.start()

    ser.clear
    ser.strln(@"Serial terminal started")


dat
