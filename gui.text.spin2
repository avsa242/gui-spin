{Spin2_v45}

con

    WIDGET_TYPE         = wgui.TYPE_TEXTLABEL

    MAX_TEXT_LABELS     = 16

    ' option flags
    FLAG_INVERT_COLORS  = 1 << 0

    ' default settings
    DEF_WIDTH           = 128
    DEF_HEIGHT          = 64
    DEF_BG_COLOR        = 0
    DEF_FG_COLOR        = 1


#include "gui-common.spin2"


obj

    wgui:   "gui.widget"
    window: "gui.window"
    button: "gui.button"


con

    struct widget_s = wgui.widget_s
    struct window_s = window.window_s
    struct button_s = button.button_s

    struct text_label_s(...
        widget_s widget, ...
        long bgcolor, ...
        long fgcolor, ...
        long p_text)


var

    text_label_s    text_label[MAX_TEXT_LABELS]

    byte            _nr_text_labels

 
pub create(p_parent, p_txt, w=0, h=0): ^text_label_s txt | ct, sx, sy
' Create a text label
'   p_parent:   parent container handle
'   p_txt:      text string
'   w, h:       dimensions of label (optional)
'   Returns:    handle of text label
    if ( _nr_text_labels < MAX_TEXT_LABELS )
        if ( w < 1 )
            w := DEF_WIDTH
        if ( h < 1 )
            h := DEF_HEIGHT

        [txt] := @text_label[_nr_text_labels]

        ct := long[p_parent][0]                 ' read container type
        if ( ct == wgui.TYPE_WINDOW )           ' get coords from parent container
            txt.widget.p_disp := window_s[p_parent].widget.p_disp
            sx := window_s[p_parent].container.cursor.x
            sy := window_s[p_parent].container.cursor.y
        elseif ( ct == wgui.TYPE_BUTTON )
            txt.widget.p_disp := button_s[p_parent].widget.p_disp
            sx := button_s[p_parent].container.cursor.x
            sy := button_s[p_parent].container.cursor.y

        txt.widget.type := wgui.TYPE_TEXTLABEL
        txt.widget.x := sx
        txt.widget.y := sy
        txt.widget.w := w
        txt.widget.h := h
        txt.widget.parent := p_parent
        txt.p_text := p_txt
        txt.widget.draw := @draw

        _nr_text_labels++

        return


pub draw(p_txt=0) | ^text_label_s txt, ^dispdrv_i disp

    ifnot ( p_txt )                             ' get the label's handle from the caller,
        [txt] := %self                          '   if none was specified
    else
        [txt] := p_txt


    [disp] := txt.widget.p_disp

    disp.bgcolor(txt.bgcolor)
    disp.fgcolor(txt.fgcolor)
    disp.pos_xy(txt.widget.x, txt.widget.y)
    disp.puts(txt.p_text)


pub set_bgcolor(^text_label_s txt, bgc)

    txt.bgcolor := bgc


pub set_fgcolor(^text_label_s txt, fgc)

    txt.fgcolor := fgc


