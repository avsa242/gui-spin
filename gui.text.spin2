{Spin2_v45}


#include "widget-common.spin2"

con

    WIDGET_TYPE         = TYPE_TEXTLABEL

    MAX_TEXT_LABELS     = 16

    ' option flags
    FLAG_INVERT_COLORS  = 1 << 0

    ' default settings
    DEF_WIDTH           = 2
    DEF_HEIGHT          = 2
    DEF_BG_COLOR        = 0
    DEF_FG_COLOR        = 1
    DEF_FONT            = 0


#include "gui-common.spin2"


obj

    window: "gui.window"
    button: "gui.button"


con

    struct window_s = window.window_s
    struct button_s = button.button_s

    struct text_label_s(...
        widget_s widget, ...
        long bgcolor, ...
        long fgcolor, ...
        long p_text, ...
        byte font_idx)


var

    text_label_s    text_label[MAX_TEXT_LABELS]

    byte            _nr_text_labels

 
pub create(p_txt, w=0, h=0): ^text_label_s txt | ct
' Create a text label
'   p_txt:      text string
'   w, h:       dimensions of label (optional)
'   Returns:    pointer to text label struct on success
'               0 on failure (text label array full)
    if ( _nr_text_labels < MAX_TEXT_LABELS )
        [txt] := @text_label[_nr_text_labels]
        txt.widget.type := TYPE_TEXTLABEL

        if ( w < 1 )
            txt.widget.w := strsize(p_txt)
        else
            txt.widget.w := w

        if ( h < 1 )
            txt.widget.h := DEF_HEIGHT
        else
            txt.widget.h := h

        txt.p_text := p_txt
        txt.widget.draw := @draw
        DEBUG("[gui.text] create(): '", zstr_(txt.p_text), "' size ", udec_(txt.widget.w), "x", udec_(txt.widget.h) )
        _nr_text_labels++

        return

    DEBUG("[textlabel] create: error; out of memory")
    return 0


pub draw(p_txt=0) | ^text_label_s txt, ^dispdrv_i disp
' Draw a text label
'   p_txt:  pointer to text label struct (optional if called indirectly via the struct itself)
    ifnot ( p_txt )                             ' get the label's pointer from the parent struct,
        [txt] := %self                          '   if none was specified
    else
        [txt] := p_txt


    [disp] := txt.widget.p_disp
    ifnot ( [disp] )
        DEBUG("[gui.text] draw(): error: no display driver defined")
        return

    if ( txt.widget.flags & FLAG_INVERT_COLORS )
        disp.bgcolor(txt.fgcolor)
        disp.fgcolor(txt.bgcolor)
    else
        disp.bgcolor(txt.bgcolor)
        disp.fgcolor(txt.fgcolor)

    disp.set_font(txt.font_idx)
    disp.pos_xy(txt.widget.x, txt.widget.y)
    disp.puts(txt.p_text)


pub set_bgcolor(^text_label_s txt, bgc)
' Set a text label's background color
'   txt:    pointer to text label struct
'   bgc:    background color
    txt.bgcolor := bgc


pub set_fgcolor(^text_label_s txt, fgc)
' Set a text label's foreground color
'   txt:    pointer to text label struct
'   fgc:    foreground/text color
    txt.fgcolor := fgc


pub set_font(^text_label_s txt, fidx)
' Set a text label's font
'   txt:    pointer to text label struct
'   fidx:   font index #
    txt.font_idx := fidx


pub set_dims_from_font(^text_label_s txt) | ^dispdrv_i disp
' Set a text label's dimensions based on the set font
    [disp] := txt.widget.p_disp
    ifnot ( [disp] )
        DEBUG("[gui.text] set_dims_from_font(): error: no display driver defined")
        return

    ifnot ( txt.p_text )
        DEBUG("[gui.text] set_dims_from_font(): error: no string set")
        return

    DEBUG("[gui.text] set_dims_from_font(): '", zstr_(txt.p_text), "' font_idx=", udec_(txt.font_idx))
    txt.widget.w := disp.str_width(txt.p_text, txt.font_idx)
    txt.widget.h := disp.font_height(0, txt.font_idx)
    DEBUG("[gui.text] set_dims_from_font() w=", udec_(txt.widget.w), " h=", udec_(txt.widget.h) )

dat
