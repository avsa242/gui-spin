{Spin2_v45}

con

    MAX_TOUCH_TAGS  = 255

    %interface pointer_i(
        pub abs_x(p): x
        pub abs_y(p): y
        pub rel_x(p): x
        pub rel_y(p): y
        pub tag_area(id, sx, sy, ex, ey)
        pub clear_tag_area(t)
    )


obj

    widget: "gui.widget"


con

    struct widget_s = widget.widget_s


var

    long pdrv

    long _tag_ptr[MAX_TOUCH_TAGS]

    byte _next_tag_id


pub clear_tag_id(id): s | ^pointer_i pointer
' Clear a previously tracked touchscreen tag
'   id: touch ID
'   Returns:    touch ID cleared on success
'               -1 on failure (unknown or invalid touch ID)
    if ( (id >= 1) and (id < MAX_TOUCH_TAGS) )
        if ( _tag_ptr[id] )
            [pointer] := pdrv
            pointer.clear_tag_area(id)
            _next_tag_id--
            return id

    return -1


pub set_pointer_driver(^pointer_i p)
' Set pointer to the pointing device/touchscreen driver object
'   p:  pointer to pointing device driver object
    pdrv := [p]
    _next_tag_id := 1                           ' init first tag ID


pub tag_object(^widget_s p_obj): id | ^pointer_i pointer
' Assign a touchscreen tag to an object, and optionally set a callback function
'   p_obj:      pointer to object's widget structure
'   id:         tag ID (optional; default is to use the next available one)
'   Returns:    assigned tag ID 
    if ( _next_tag_id < MAX_TOUCH_TAGS )
        id := _next_tag_id
    else
        return -1   

    [pointer] := pdrv

    _tag_ptr[id] := @p_obj
    pointer.tag_area(id, widget.widget_area(@p_obj) )
    widget.set_touch_id(@p_obj, id)
    _next_tag_id++
    
    return id   


dat
