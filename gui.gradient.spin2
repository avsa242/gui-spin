{Spin2_v45}


#include "widget-common.spin2"
#include "gui-common.spin2"

con

    WIDGET_TYPE         = TYPE_GRADIENT

    MAX_GRADIENTS       = 1

    ' option flags
    FLAG_GRAD_VERTICAL  = 1 << 0
    FLAG_GRAD_HORIZONTAL= 1 << 1

    ' default settings
    DEF_WIDTH           = 2
    DEF_HEIGHT          = 2
    DEF_FLAGS           = 0


con

    struct gradient_s(...
        widget_s widget, ...
        long color0, ...
        long color1)


var

    gradient_s  gradient[MAX_GRADIENTS]
    byte        _nr_gradients


pub create(w=0, h=0): ^gradient_s grad
' Create a gradient object
'   w, h:   dimensions (optional; default is to use dimensions defined at build-time)
    if ( _nr_gradients < MAX_GRADIENTS )
        if ( w < 1 )
            w := DEF_WIDTH
        if ( h < 1 )
            h := DEF_HEIGHT

        [grad] := @gradient[_nr_gradients]
        grad.widget.w := w
        grad.widget.h := h
        grad.widget.type := TYPE_GRADIENT
        grad.widget.draw := @draw

        _nr_gradients++
        DEBUG("[gui.gradient] create(): ", uhex_([grad]), " x=", udec_(grad.widget.x), " y=", udec_(grad.widget.y), " w=", udec_(grad.widget.w), " h=", udec_(grad.widget.h) )
        return

    DEBUG("[gui.gradient] create: error; out of memory")
    return 0


pub draw(p_grad=0) | ^gradient_s grad, ^dispdrv_i disp
' Draw a gradient
'   p_grad:     pointer to gradient struct
    ifnot ( p_grad )
        [grad] := %self
    else
        [grad] := p_grad

    [disp] := grad.widget.p_disp

    ifnot ( [disp] )
        DEBUG("[gui.gradient] draw(): error: no display driver defined")
        return

    if ( grad.widget.flags & FLAG_GRAD_VERTICAL )
        disp.vgradient( grad.widget.x, grad.widget.y, ...
                        grad.widget.w, grad.widget.h, ...
                        grad.color0, grad.color1)
    elseif ( grad.widget.flags & FLAG_GRAD_HORIZONTAL )
        disp.hgradient( grad.widget.x, grad.widget.y, ...
                        grad.widget.w, grad.widget.h, ...
                        grad.color0, grad.color1)


pub set_color0(^gradient_s grad, c)
' Set first color of a gradient
'   grad:   pointer to gradient struct
'   c:      color
    grad.color0 := c


pub set_color1(^gradient_s grad, c)
' Set second color of a gradient
'   grad:   pointer to gradient struct
'   c:      color
    grad.color1 := c


dat
