con

    ' display driver API requirements
    %interface dispdrv_i(
        pub box(x1, y1, x2, y2, c, f)
        pub bgcolor(c)
        pub fgcolor(c)
        pub font_height(ch, fidx): h
        pub font_width(ch, fidx): w
        pub hline(y, xs, len, c)
        pub line(x1, y1, x2, y2, c)
        pub newline()
        pub plot(x, y, c)
        pub pos_xy(x, y)
        pub puts(p_str)
        pub set_clip_rect(sx, sy, ex, ey)
        pub set_font(i)
        pub show_context()
        pub str_width(p_str, fidx): w
        pub vline(x, ys, len, c)
    )

    ' terminal driver API requirements
    %interface termdrv_i(
        pub clear_line()
        pub newline()
        pub pos_x(x)
        pub pos_xy(x, y)
        pub puts(p_str)
    )

