{
----------------------------------------------------------------------------------------------------
    Filename:       gui.battery-gauge.spin2
    Description:    Battery gauge GUI widget
    Author:         Jesse Burt
    Started:        Jan 15, 2024
    Updated:        Mar 22, 2025
    Copyright (c) 2025 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------

    Requirements:
        a display driver that provides the following interfaces:
            con MAX_COLOR = xxx (xxx is the maximum possible color value the driver supports)
            pub box(sx, sy, ex, ey, color, fill_flag)
            pub line(sx, sy, ex, ey, color)
        build-time symbol DISP_DRIVER defined with the display driver filename
        Example:
            flexspin -DDISP_DRIVER=\"display.lcd.st7735\" -DST7789 -DGFX_DIRECT -2 app.spin2
            (define DISP_DRIVER as the driver filename
    Operational overview:
        This object is first initialized with a pointer to your display driver's object
        The battery gauge can then be drawn in either horizontal ( draw_batt1_horiz() ) or
            vertical orientation ( draw_batt1_vert() ), respectively. The parameter is the
            state of charge in whole percent (0..100).
        The following attributes can optionally be changed:
            set_bg_color():         set gauge inside fill/background color
            set_bar_color():        set gauge bars color
            set_outline_color():    set outline color of gauge
            set_posxy():            set screen position of gauge
            set_scale():            set drawing scale factor of gauge (whole numbers >= 1)
            The defaults are:
                * color 0 background (usually black)
                * the display's MAX_COLOR as the gauge outline color
                * screen position (0, 0)
                * scale factor 1

        Example:

        obj

            lcd:        DISP_DRIVER
            batt_gauge: "gui.battery-gauge"

        pub main()

            batt_gauge.attach_display_driver(@lcd)
            ' or the following, for short:
            ' batt_gauge.attach(@lcd)
}

con

    ' define the requirements of the display driver interface
    %interface disp_i(
        pub plot(x, y, c)
        pub box(x1, y1, x2, y2, c, f)
        pub line(x1, y1, x2, y2, c)
    )

    ' battery image basic dimensions
    BATT_WID    = 4
    BATT_LEN    = 10


var

    ' batt gauge attributes
    long _bar_color, _bg_color, _outline_color
    word _sx, _sy
    byte _scale


pub draw_batt1_horiz(^disp_i disp, p) | c, ex, ey, l, s
' Draw a battery gauge (horizontal layout)
'   p:  state of charge (percent)
    p := (0 #> p <# 100) / 10
    ex := _sx + (BATT_LEN * _scale)
    ey := _sy + (BATT_WID * _scale)
    l := (ex-_sx)                               ' get length (scaled) of battery

    ' draw the battery
    disp.box(_sx, _sy, ex+1, ey, _outline_color, false)
    disp.line(ex+2, _sy+1, ex+2, ey-1, _outline_color)

    ' draw the state-of-charge
    s := p * (l / 10)                           ' scaled SoC bar/filled length
    if ( p )
        repeat c from 0 to s-1
            disp.line(_sx+1+c, _sy+1, _sx+1+c, ey-1, _bar_color)


pub draw_batt1_vert(^disp_i disp, p) | c, ex, ey, l, s
' Draw a battery gauge (vertical layout)
'   p:  state of charge (percent)
    p := (0 #> p <# 100) / 10
    ex := _sx + (BATT_WID * _scale)
    ey := _sy + (BATT_LEN * _scale)
    l := (ey-_sy)                               ' length of battery in pixels (after scaling)

    ' draw the battery
    disp.box(_sx, _sy, ex, ey+1, _outline_color, false)
    disp.line(_sx+1, _sy-1, ex-1, _sy-1, _outline_color)

    ' draw the state-of-charge
    s := p * (l / 10)                           ' scaled SoC bar/filled length
    if ( p )
        repeat c from 0 to s-1
            disp.line(_sx+1, ey-c, ex-1, ey-c, _bar_color)


pub set_bg_color(c)
' Set battery inside background/fill color
    _bg_color := c


pub set_bar_color(c)
' Set battery state of charge bar color
    _bar_color := c


pub set_outline_color(c)
' Set battery outline color
    _outline_color := c


pub set_posxy(x, y)
' Set upper-left screen position of battery gauge
    _sx := x
    _sy := y


pub set_scale(s)
' Set drawing scale factor
    _scale := 1 #> s                            ' clamp to minimum of 1


DAT
