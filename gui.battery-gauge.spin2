----------------------------------------------------------------------------------------------------

    Requirements:
        a display driver that provides the following interfaces:
            pub box(sx, sy, ex, ey, color, fill_flag)
            pub line(sx, sy, ex, ey, color)
        a window to draw the gauge to (window_s type from gui.window.spin2)
}

#include "gui.common.spin2"


con

    ' limits
    MAX_BATT_GAUGES = 1

    ' battery gauge default dimensions
    BATT_WID        = 4
    BATT_LEN        = 10


var

    batt_gauge_s    gauge[MAX_BATT_GAUGES]
    byte            _nr_gauges


pub create(^window_s pwin, x, y): i | wp
' Create a battery gauge object
'   pwin:   parent window (pointer to window_s struct)
'   x, y:   gauge upper-left position (pixels)
'   Returns:
'           gauge handle on success (pointer)
'           0 on failure (exceeded parent window's maximum number of obects,
'                           or this object's maximum number of gauges)
    if ( (pwin.nr_obj < MAX_WIN_OBJS) and (_nr_gauges < MAX_BATT_GAUGES) )
        i := @gauge[_nr_gauges]
        wp := @gauge[_nr_gauges].widget

        set_type(wp,        OBJ_BATT_GAUGE)
        set_parent_obj(wp,  @pwin)
        set_posxy(wp,       x, y)
        set_dims(wp,        BATT_LEN, BATT_WID)
        set_bgcolor(wp,     pwin.widget.bgcolor)
        set_fgcolor(wp,     pwin.widget.fgcolor)

        pwin.object[pwin.nr_obj] := i
        pwin.nr_obj++
        _nr_gauges++
        return

    return 0


pub destroy(^batt_gauge_s bg): s
' Destroy a battery gauge object
'   plot:       battery gauge (pointer to batt_gauge_s struct)
'   Returns:    number of gauges before destruction
    if ( (_nr_gauges > 0) and (bg.widget.type == OBJ_BATT_GAUGE) )
    ' do some basic safeguards before just clearing memory
        bg~
        s := _nr_gauges
        _nr_gauges--
        return

    return false


pub draw(^batt_gauge_s gauge) | ^window_s win, ^dispdrv_i disp, sx, sy, ex, ey, p, l, h, s, c
' Draw a battery gauge
'   gauge:  battery gauge data (pointer to batt_gauge_s struct)
    [win] := gauge.widget.parent                ' get handle on parent window
    [disp] := win.p_disp                        ' get the display driver interface from the parent
    sx := win.widget.x+gauge.widget.x
    sy := win.widget.y+gauge.widget.y
    ex := sx + gauge.widget.w-1
    ey := sy + gauge.widget.h-1
    p := (0 #> gauge.state <# 100)
    l := (ex-sx)-4                              ' fill length (account for battery body + tab/tip)
    h := ( (ey-sy)/4 ) #> ey-sy-1               ' battery tab/tip height

    ' draw the battery
    disp.box(sx, sy, ex-2, ey, gauge.outline_color, false)
    disp.box(ex-2, sy+h, ex, ey-h, gauge.outline_color, true)

    ' draw the state-of-charge
    if ( p )
        s := (p * l) / 100                      ' scaled SoC bar/filled length
        disp.box(sx+1, sy+1, sx+1+s, ey-1, gauge.widget.fgcolor, true)


pub ptr_widget(^batt_gauge_s gauge): ^widget_s ow
' Get pointer to a battery gauge's widget configuration
'   gauge:      battery gauge (pointer to batt_gauge_s struct)
'   Returns:    pointer to widget_s struct
    return @gauge.widget


pub set_bar_color = set_fgcolor
' Set battery state of charge bar color


pub set_outline_color(^batt_gauge_s gauge, c)
' Set battery outline color
    gauge.outline_color := c


pub set_state(^batt_gauge_s gauge, s)
' Set gauge state of charge
'   s:  state of charge (percent, 0..100)
    gauge.state := s


dat
